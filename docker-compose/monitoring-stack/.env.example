# Copy to .env and edit. Keep .env out of version control.

# Grafana initial admin credentials (read on first start only; change the
# password in Grafana afterwards or rotate here and recreate grafana_data).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-string

# Public URL Grafana uses for links and redirects.
GRAFANA_ROOT_URL=http://localhost:3000

# How long Prometheus keeps samples.
PROMETHEUS_RETENTION=30d
